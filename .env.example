# ── Email (Resend) — delivers every /request and /espa form submission ──
# There is no database: a form submission IS an email. If RESEND_API_KEY is
# unset the route returns 502 and the visitor is shown the retry screen, so
# this must be set in production.
# Get a key at https://resend.com.

RESEND_API_KEY=

# Where form submissions land. Defaults to info@akosds.com if unset.
LEAD_ALERT_EMAIL=info@akosds.com

# Sender address. akosds.com is verified in Resend (eu-west-1), so mail is sent
# from our own domain with real DKIM/SPF rather than the shared resend.dev
# sender. Any address on the domain works; keep it one nobody replies to, the
# route sets Reply-To to the lead.
LEAD_MAIL_FROM=leads@akosds.com

# ── Funding watch (scripts/funding-watch.ts, weekly Railway cron) ──
# Where the weekly digest of new Greek SME funding programmes goes. Defaults
# to digitalaakos@gmail.com if unset. WATCH_WINDOW_DAYS (default 9) is how far
# back each run looks and must stay longer than the gap between runs.

WATCH_ALERT_EMAIL=digitalaakos@gmail.com
