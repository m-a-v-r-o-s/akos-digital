# ── Supabase (lead capture for /request + CRM at /crm) ──
# Server-side only. The SERVICE ROLE key bypasses Row Level Security, so it
# must NEVER be prefixed with NEXT_PUBLIC_ or exposed to the browser.
# Find both values in your Supabase project: Settings → API.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── CRM access (/crm) ──
# Secret used to sign the CRM session cookie. Use a long random string.
# Generate one with:  openssl rand -hex 32
# The CRM stays locked until this is set.
CRM_SESSION_SECRET=

# Where the one-time access passkey is emailed when the Obi-Wan page is clicked.
CRM_ALERT_EMAIL=info@akosds.com

# ── Email (Resend) — sends the CRM passkey ──
# Get a key at https://resend.com. Tip: sign up with info@akosds.com and you can
# send from onboarding@resend.dev to that same address with no domain setup.
# To send from your own domain, verify akosds.com in Resend and set CRM_MAIL_FROM.
RESEND_API_KEY=
CRM_MAIL_FROM=onboarding@resend.dev
