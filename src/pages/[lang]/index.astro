---
import Base from "../../layouts/Base.astro";
import Theta from "../../components/Theta.astro";
import Shot from "../../components/Shot.astro";
import Icon from "../../components/Icon.astro";
import { person, education, projects, services, sectors } from "../../lib/data.ts";
import { LANGS, type Lang } from "../../lib/i18n.ts";
import { staticPageMeta } from "../../lib/seo.ts";
import { localeHref, isInternalHref, SEVENMERO_URL } from "../../lib/links.ts";
import { ui } from "../../lib/ui.ts";
import { tools } from "../../lib/stack.ts";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = ui[lang];
const featured = projects.filter((p) => p.caseStudy);
const more = projects.filter((p) => !p.caseStudy);
const ext = (href: string) => (isInternalHref(href) ? {} : { target: "_blank", rel: "noopener noreferrer" });
const stripTags = (html: string) => html.replace(/<[^>]+>/g, "");
// EU flag as a disc: 12 upright five-point stars on a ring, star radius about a sixth of the ring's (the flag's own ratio).
const euStar = "M" + Array.from({ length: 10 }, (_, k) => {
  const r = k % 2 ? 0.54 : 1.4, a = (k * Math.PI) / 5 - Math.PI / 2;
  return `${(r * Math.cos(a)).toFixed(2)} ${(r * Math.sin(a)).toFixed(2)}`;
}).join("L") + "Z";
const euStars = Array.from({ length: 12 }, (_, i) => {
  const a = (i * Math.PI) / 6 - Math.PI / 2;
  return `translate(${(7.2 * Math.cos(a)).toFixed(2)} ${(7.2 * Math.sin(a)).toFixed(2)})`;
});
---
<Base meta={staticPageMeta("home", lang)} darkTop current="home">
  <section class="hero dark" aria-label={person.name[lang]}>
    <div class="wrap hero-grid">
      <p class="locpill">
        <span>{t.location[0]}<br />{t.location[1]}</span>
        <!-- Natural Earth 10m coastlines: mainland Greece, Crete, Kos, Rhodes, Cyprus -->
        <span class="isles" aria-hidden="true">
          <svg class="on" data-ms="3200" viewBox="0 0 24 24" fill="currentColor"><path d="M4.5 4.7L5.6 4.7L6.0 4.5L6.5 4.6L7.1 4.4L7.5 3.7L8.0 3.5L9.6 3.6L9.9 3.3L10.0 3.5L10.3 2.7L11.5 2.8L11.8 2.4L12.9 2.6L13.8 2.2L14.3 2.2L14.3 1.9L14.7 2.0L14.9 1.8L15.1 2.0L15.8 1.8L16.0 2.3L16.6 2.6L17.0 2.4L18.2 3.1L19.1 2.8L19.5 2.9L19.9 2.7L20.2 2.8L20.9 2.6L21.1 1.9L20.7 1.3L20.9 1.1L21.3 1.0L22.4 1.6L22.5 2.7L22.3 2.6L21.6 3.1L21.7 4.2L21.3 4.5L20.8 5.2L20.6 4.9L20.7 4.8L19.1 4.6L18.3 4.3L17.9 4.3L17.8 4.0L17.5 4.1L16.7 4.7L16.2 4.7L16.0 4.3L15.5 4.3L15.2 4.6L15.3 4.8L14.5 5.2L13.7 5.0L13.3 5.1L13.2 5.4L13.9 6.0L13.6 6.1L13.7 6.5L14.2 6.6L14.2 6.3L15.4 7.5L15.1 7.7L14.7 7.1L13.9 6.7L13.3 6.7L13.3 7.1L14.1 7.7L14.1 8.4L13.6 8.2L13.1 7.3L12.4 7.0L12.1 7.3L12.1 7.6L13.4 8.5L12.1 8.3L11.9 7.2L10.6 6.6L10.4 6.1L10.9 5.9L10.7 5.5L10.1 6.1L9.6 6.3L9.9 6.7L9.6 7.5L9.6 8.0L10.1 8.4L10.8 9.9L11.3 10.2L12.1 11.6L11.6 11.9L11.2 11.9L11.2 11.7L11.3 11.9L11.7 11.6L11.4 11.1L10.8 10.8L10.8 11.0L10.5 11.1L10.4 11.4L11.0 12.0L10.9 12.3L11.2 12.1L10.3 12.8L9.8 12.6L9.5 12.9L10.0 12.9L10.6 13.3L11.1 13.3L11.3 13.8L11.6 13.6L12.0 13.7L12.1 13.9L11.9 14.1L12.2 14.2L12.1 14.3L12.8 14.3L13.1 14.9L14.0 15.2L14.4 15.7L14.1 15.9L14.2 16.8L14.4 17.2L14.3 17.8L14.0 17.7L13.7 17.2L13.5 17.2L13.2 16.6L12.8 16.5L12.8 16.2L12.3 16.5L11.0 16.7L11.0 16.9L11.6 17.2L11.4 17.5L11.5 17.5L11.5 18.0L12.1 18.3L12.0 18.0L12.3 17.9L12.2 18.4L12.7 18.7L11.8 18.9L11.7 19.0L11.9 19.1L11.5 19.3L11.2 19.0L11.4 18.7L11.1 18.5L11.0 18.6L10.7 18.3L10.5 18.4L10.3 18.1L10.1 18.2L10.2 18.9L10.7 19.7L10.7 20.0L10.9 20.2L11.4 21.4L11.1 21.7L11.1 21.9L11.6 22.8L11.3 22.8L11.2 22.5L10.9 22.5L10.6 21.9L10.4 21.9L10.3 21.4L10.0 21.3L9.6 21.4L9.6 21.9L9.5 21.8L9.3 22.1L9.4 23.0L8.9 22.5L9.0 21.7L8.5 20.9L8.2 20.8L8.3 20.4L7.6 20.5L7.6 21.1L7.7 21.3L7.4 21.6L7.2 21.3L6.9 21.2L6.9 20.7L6.4 19.9L6.8 19.3L6.8 18.9L6.4 18.2L5.9 17.8L5.6 17.9L5.5 17.3L5.0 16.9L5.0 16.6L5.7 16.3L5.8 15.5L6.6 15.8L7.3 15.0L7.9 15.1L8.5 15.6L10.0 16.1L10.6 16.6L10.9 16.5L10.6 16.2L11.5 16.1L11.7 15.7L11.4 15.5L10.4 15.5L9.9 14.8L9.6 15.2L9.1 14.5L9.0 15.0L8.5 14.9L8.4 15.1L7.7 14.7L7.3 14.8L7.1 15.0L6.5 15.0L6.3 15.2L6.0 15.0L6.2 15.1L6.2 14.9L6.0 14.9L5.6 14.4L5.7 14.8L5.1 15.1L4.9 15.0L5.1 14.8L4.9 14.7L4.9 14.2L4.7 14.3L4.6 13.7L4.3 13.6L4.2 13.1L3.9 13.3L3.8 13.1L4.0 12.8L3.9 12.5L4.0 12.6L4.2 12.5L4.2 12.6L4.5 12.5L4.9 12.8L4.9 12.7L5.2 12.8L5.1 12.3L4.9 12.0L4.8 12.3L4.3 12.0L4.1 12.1L4.0 11.8L3.8 12.2L4.1 12.4L3.8 12.5L3.6 12.0L3.0 11.4L3.0 11.1L2.5 11.0L2.2 10.6L2.1 10.5L2.3 10.5L2.1 10.3L2.3 10.2L1.9 10.1L2.0 9.7L1.4 9.4L2.0 9.7L2.2 9.6L2.4 9.3L2.3 9.0L2.7 8.9L2.4 8.2L2.6 8.2L2.8 7.9L3.5 7.8L3.9 6.5L4.1 6.2L4.3 6.3L4.7 5.9L4.7 5.5L4.4 5.0L4.5 4.7Z"></path></svg>
          <svg data-ms="2600" viewBox="0 0 24 24" fill="currentColor"><path d="M23.0 11.9L22.6 12.5L22.8 13.2L23.0 13.1L22.7 13.5L22.7 14.0L22.4 14.6L21.6 14.9L21.3 15.0L21.1 14.8L20.6 14.8L20.3 14.6L19.0 14.9L17.4 14.8L16.6 15.1L15.3 15.1L14.3 15.4L13.8 15.4L13.5 15.6L13.1 15.5L12.8 15.6L10.6 15.6L10.7 15.4L10.7 14.6L10.4 14.1L9.2 14.0L8.9 13.6L8.6 13.5L8.4 13.5L7.9 13.3L7.9 13.1L7.1 13.2L6.5 13.1L6.4 13.0L5.5 13.0L5.2 13.1L4.7 12.7L3.7 12.7L3.4 12.5L3.1 12.7L2.3 12.8L2.2 12.7L1.5 12.7L1.5 12.5L1.0 12.2L1.0 12.0L1.3 11.9L1.2 11.4L1.5 10.8L1.3 10.6L1.5 10.2L1.4 9.9L1.5 9.4L1.7 9.1L1.8 9.9L2.0 10.1L2.5 10.1L2.7 9.9L2.5 8.7L2.8 8.4L3.1 8.5L3.0 9.4L3.3 9.8L5.0 10.0L5.2 9.9L5.2 9.7L5.5 9.7L5.4 9.3L5.7 9.2L6.2 9.3L6.4 9.8L6.2 10.0L5.4 10.0L5.3 10.2L6.3 10.6L6.8 10.4L6.9 11.4L7.5 11.6L9.2 11.3L10.3 10.9L11.4 11.1L11.8 10.9L12.3 11.1L12.4 10.9L13.1 11.1L13.1 11.6L13.2 11.7L15.6 11.7L16.0 12.1L16.2 12.2L17.8 11.6L18.7 11.7L18.3 12.2L18.3 12.4L18.4 12.5L18.5 12.2L18.6 12.5L18.4 12.6L18.2 13.3L18.3 13.7L18.9 13.9L19.2 13.8L19.3 13.5L19.7 13.2L20.4 13.1L20.9 12.7L21.4 12.9L21.3 13.0L21.5 13.1L21.7 13.1L22.0 12.9L22.0 12.8L22.5 12.2L22.8 12.2L22.8 11.9L23.0 11.9Z"></path></svg>
          <svg data-ms="2000" viewBox="0 0 24 24" fill="currentColor"><path d="M19.2 4.8L19.7 5.7L22.3 6.4L23.0 7.5L21.4 8.5L15.9 10.1L14.6 10.8L11.7 14.0L10.6 14.2L9.4 14.0L8.1 13.6L7.5 13.2L4.6 14.4L3.9 15.3L4.5 16.6L3.7 16.8L3.4 17.5L3.4 18.4L3.7 19.2L2.8 19.0L1.9 18.3L1.2 17.4L1.0 16.9L1.0 14.7L1.4 13.7L1.9 14.0L3.0 12.7L3.2 13.0L4.5 13.6L5.5 12.3L6.1 11.0L7.9 9.4L8.1 9.1L13.4 5.8L19.2 4.8Z"></path></svg>
          <svg data-ms="2000" viewBox="0 0 24 24" fill="currentColor"><path d="M20.8 1.9L20.3 2.4L20.6 4.2L20.0 4.5L19.6 6.2L18.7 7.4L18.4 9.5L17.8 9.9L17.3 11.5L16.7 11.4L16.4 11.6L16.2 12.2L15.9 12.3L15.1 14.2L15.7 14.5L16.2 14.7L16.0 15.3L15.6 15.8L16.0 16.6L14.4 16.0L13.8 16.0L13.0 16.3L11.6 17.2L11.0 17.7L8.9 21.0L7.8 22.1L6.3 23.0L4.8 22.0L4.1 20.6L4.6 20.0L5.5 17.3L5.7 16.3L5.6 15.4L4.0 13.7L4.0 13.5L4.3 13.3L4.1 13.1L3.9 12.9L3.5 12.9L3.2 12.6L3.8 12.4L5.1 11.5L6.1 11.0L6.0 10.7L6.3 10.3L6.3 9.7L7.2 8.0L8.1 7.8L9.6 6.2L10.0 5.5L11.9 4.8L15.4 3.0L15.9 2.6L16.9 2.1L18.9 2.2L20.0 1.0L20.2 1.0L20.4 1.2L20.8 1.7L20.8 1.9Z"></path></svg>
          <svg data-ms="3200" viewBox="0 0 24 24" fill="currentColor"><path d="M22.6 5.6L23.0 5.5L22.8 6.1L22.5 6.1L21.6 6.7L20.7 7.5L18.7 8.7L17.8 9.9L17.1 9.8L16.9 9.9L16.5 10.5L16.4 11.6L17.9 13.1L18.1 13.7L18.3 13.9L17.9 13.9L17.5 13.7L16.5 13.8L16.1 14.2L15.5 13.8L14.7 13.8L14.4 13.9L14.0 14.3L13.9 15.2L13.7 15.3L13.6 15.6L13.1 15.7L12.8 16.0L12.1 16.3L11.8 16.3L11.7 16.1L11.7 16.5L10.4 17.0L9.5 16.9L8.7 17.1L8.0 17.7L8.0 18.2L8.2 18.5L7.4 18.5L7.4 18.2L7.1 17.5L6.3 17.3L5.1 17.6L4.7 17.5L3.7 17.0L2.9 16.8L2.3 16.4L2.0 15.3L1.5 14.7L1.5 14.4L1.0 13.0L1.0 12.5L1.1 12.4L1.3 12.5L1.8 12.9L2.3 13.0L3.0 12.6L3.7 11.4L3.9 11.5L4.6 11.3L5.5 11.4L6.3 11.8L6.6 11.7L7.1 11.2L7.2 10.8L7.3 9.6L7.1 8.9L8.5 9.3L9.2 9.3L12.0 9.7L14.2 9.3L15.3 8.7L15.8 8.8L17.7 8.1L18.6 7.6L19.1 7.1L20.4 6.7L22.6 5.6Z"></path></svg>
        </span>
      </p>
      <Theta />
      <p class="hero-role">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 6l12 12M18 8v10H8"></path></svg>
        <span>{t.role}<small>{person.company}</small></span>
        <a class="btn btn-accent" href={`/${lang}/request`} style="justify-self:start;font-size:17px;letter-spacing:0">{t.quote} <Icon name="arrow" size={16} /></a>
      </p>
    </div>
    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        {[0, 1].map(() => (
          <>
            <span>{person.name.en}</span><b>·</b><span>{person.name.el}</span><b>·</b>
          </>
        ))}
      </div>
    </div>
    <p class="sr-only">{person.name[lang]}</p>
  </section>

  <section class="section" id="about">
    <div class="wrap intro">
      <h1 class="h-lg reveal">{person.tagline[lang]}</h1>
      <div class="lede reveal">
        {person.about[lang].map((p) => <p>{stripTags(p)}</p>)}
        <a class="round magnet" href="#work" data-magnet><span>{t.seeWork}</span></a>
      </div>
    </div>
  </section>

  <section aria-label={t.quote}>
    <div class="wrap ctas">
      <a class="cta cta-main" href={`/${lang}/request`}>
        <span>{t.quote}<span class="sub" style="color:inherit;opacity:.75">{t.quoteSub}</span></span>
        <Icon name="arrow" size={32} />
      </a>
      <a class="cta cta-ticket" href={SEVENMERO_URL} target="_blank" rel="noopener">
        <span class="stub"><b>{t.sevenmeroPrice}</b><small>{t.sevenmeroVat}</small></span>
        <span class="body">
          <span>{t.sevenmero}<span class="sub">{t.sevenmeroSub}</span></span>
          <Icon name="arrow" size={22} />
        </span>
      </a>
      <a class="cta cta-stamp" href={`/${lang}/espa`}>
        <span>{t.espa}<span class="sub">{t.espaSub}</span></span>
        <span class="stamp" aria-hidden="true">
          <svg class="ring" viewBox="0 0 100 100">
            <path id="stamp-ring" d="M50,50 m-37,0 a37,37 0 1,1 74,0 a37,37 0 1,1 -74,0" fill="none"></path>
            <text><textPath href="#stamp-ring" textLength="226" lengthAdjust="spacing">ΕΣΠΑ 2021-2027 • ΕΣΠΑ 2021-2027 •</textPath></text>
          </svg>
          <svg class="eu" viewBox="-12 -12 24 24">
            <circle r="12"></circle>
            {euStars.map((t, i) => <g transform={t}><path d={euStar} style={`--i:${i}`}></path></g>)}
          </svg>
        </span>
      </a>
    </div>
  </section>

  <section class="section" id="work">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h-lg">{t.works}<span class="count">{projects.length}</span></h2>
        <p class="eyebrow">{t.recentWork}</p>
      </div>
      <ul class="rows list-plain" data-rows>
        {featured.map((p, i) => (
          <li>
            <a class="row" href={localeHref(p.caseStudy!, lang)} data-i={i}>
              <span class="t">{p.title}</span>
              <span class="meta">
                {p.status && <span class="badge">{p.status[lang]}</span>}
                <span>{p.kind[lang]}</span>
              </span>
              <span class="thumb"><Shot src={`work/${p.shot}`} alt="" sizes="100vw" /></span>
            </a>
          </li>
        ))}
      </ul>
      <div class="preview" data-preview aria-hidden="true">
        <div class="strip">
          {featured.map((p) => (
            <div><Shot src={`work/${p.shot}`} alt="" sizes="400px" /></div>
          ))}
        </div>
        <span class="view">{t.view}</span>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0" aria-labelledby="more-h">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h-md" id="more-h">{t.moreWork}<span class="count">{more.length}</span></h2>
        <p class="eyebrow">{t.moreWorkSub}</p>
      </div>
      <ul class="cards list-plain">
        {more.map((p) => {
          const first = p.links[0];
          return (
            <li class="card reveal">
              {p.video ? (
                <span class="frame">
                  <video class="whole" data-inview muted loop playsinline preload="none" poster={`${p.video.src}.webp`} aria-label={p.title} width={p.video.width} height={p.video.height}>
                    <source src={`${p.video.src}.webm`} type="video/webm" />
                    <source src={`${p.video.src}.mp4`} type="video/mp4" />
                  </video>
                </span>
              ) : first ? (
                <a class="frame" href={localeHref(first.href, lang)} {...ext(first.href)} tabindex="-1" aria-hidden="true">
                  <Shot src={`work/${p.shot}`} alt="" sizes="(min-width: 900px) 33vw, 100vw" />
                </a>
              ) : (
                <span class="frame"><Shot src={`work/${p.shot}`} alt="" /></span>
              )}
              <h3 class="t">
                {first ? <a href={localeHref(first.href, lang)} {...ext(first.href)} style="text-decoration:none">{p.title}</a> : p.title}
                {p.status && <span class="badge">{p.status[lang]}</span>}
              </h3>
              <p class="desc">{p.description[lang]}</p>
              <div class="foot">
                <span>{p.tags.slice(0, 3).join(" · ")}</span>
                <span class="links">
                  {p.links.map((l) => (
                    <a href={localeHref(l.href, lang)} {...ext(l.href)}>{l.label[lang]} <Icon name="arrow" size={12} /></a>
                  ))}
                  {p.video?.walkthrough && (
                    <button type="button" data-lightbox-open={`lb-${p.shot}`}>{t.watch} <Icon name="arrow" size={12} /></button>
                  )}
                </span>
              </div>
              {p.video?.walkthrough && (
                <dialog class="lightbox" id={`lb-${p.shot}`} aria-label={`${p.title}, ${t.watch}`}>
                  <div class="sheet">
                    <button class="close" type="button" data-lightbox-close aria-label={t.close}>✕</button>
                    <video controls playsinline preload="none" poster={`${p.video.src}.webp`} width={p.video.width} height={p.video.height}>
                      <source src={`${p.video.src}.webm`} type="video/webm" />
                      <source src={`${p.video.src}.mp4`} type="video/mp4" />
                    </video>
                  </div>
                </dialog>
              )}
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="section tint" id="sectors">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h-lg">{t.whoFor}</h2>
        <p class="eyebrow">{t.sectors} · {sectors.length}</p>
      </div>
      <ul class="tiles list-plain">
        {sectors.map((s, i) => (
          <li class="reveal">
            <a class="tile" href={`/${lang}/sectors/${s.slug}`}>
              <span class="n">{String(i + 1).padStart(2, "0")}</span>
              <h3>{s.title[lang]}</h3>
              <p>{s.hook[lang]}</p>
              <span class="go">{t.explore} <Icon name="arrow" size={14} /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="services">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h-lg">{t.whatIDo}</h2>
        <a class="btn" href={`/${lang}/services`}>{t.allServices} <Icon name="arrow" size={16} /></a>
      </div>
      <ul class="lines list-plain">
        {services.map((s, i) => {
          const inner = (
            <>
              <span class="n">{String(i + 1).padStart(2, "0")}</span>
              <h3>{s.title[lang]}</h3>
              <p>{s.description[lang]}</p>
            </>
          );
          return <li class="reveal">{s.href ? <a href={`/${lang}${s.href}`} style="display:contents">{inner}</a> : inner}</li>;
        })}
      </ul>
    </div>
  </section>

  <section class="section" style="padding-top:0" id="stack" aria-labelledby="stack-h">
    <div class="wrap">
      <div class="section-head stack-head">
        <h2 class="h-lg" id="stack-h">{t.builtWith}<span class="count">{tools.length}</span></h2>
        <p class="lede-sm">{t.builtWithLede}</p>
      </div>
      <ul class="bw-tiles list-plain">
        {tools.map((tool) => (
          <li class="bw-tile" style={tool.icon ? `--brand:#${tool.icon.hex}` : undefined}>
            {tool.icon
              ? <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true"><path d={tool.icon.path}></path></svg>
              : <span class="wm">{tool.name}</span>}
            {tool.icon && <span class="nm">{tool.name}</span>}
            <span class="use">{tool.use[lang]}</span>
          </li>
        ))}
      </ul>
      <p class="stack-note">{t.builtWithNote}</p>
    </div>
  </section>

  <section class="section" style="padding-top:0" id="education">
    <div class="wrap">
      <div class="section-head"><h2 class="h-md">{t.education}</h2></div>
      <div class="edu">
        {education.map((e) => (
          <div class="reveal">
            <img class="edu-logo" src={e.logo.src} width={e.logo.width} height={e.logo.height} alt={e.institution[lang]} loading="lazy" decoding="async" />
            <span class="muted">{e.period}</span>
            <h3>{e.degree[lang]}, <a class="prose-link" href={e.institutionUrl} target="_blank" rel="noopener noreferrer">{e.institution[lang]}</a></h3>
            <p class="muted" style="color:var(--ink-2)">{e.description[lang]}</p>
            <p class="tags">{e.tags.join(" · ")}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
