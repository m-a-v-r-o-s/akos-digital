---
/**
 * The owner's view of the first-party counter. Server-rendered on request,
 * behind an emailed one-time code (src/lib/statsAuth.ts). Plain forms, no JS.
 */
import "@fontsource-variable/commissioner/wght.css";
import "../styles/global.css";
import { validSession } from "../lib/statsAuth.ts";
import { load, summarise } from "../lib/stats.ts";

export const prerender = false;

const authed = validSession(Astro.request.headers.get("cookie"));
const q = Astro.url.searchParams;
const range = [7, 30, 90].includes(Number(q.get("d"))) ? Number(q.get("d")) : 30;
const s = authed ? summarise(await load(range), range) : null;
const peak = s ? Math.max(1, ...s.days.map((d) => d.n)) : 1;
const pct = (n: number) => (s && s.total ? Math.round((n / s.total) * 100) : 0);
const msg =
  q.get("e") === "locked" ? "Too many tries. Wait a moment, then try again."
  : q.get("e") === "bad" ? "That code didn't match, or it expired."
  : q.get("wait") ? "Three codes were sent in the last 15 minutes. Use the latest one, or wait."
  : q.get("mailfail") ? "The code couldn't be emailed. Check RESEND_API_KEY."
  : "";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Stats · akosds.com</title>
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <main class="wrap" style="padding-block:48px 96px;display:grid;gap:40px;max-width:1100px">
    <header style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:16px">
      <div><p class="eyebrow">akosds.com</p><h1 class="h-lg">Page views</h1></div>
      {authed && (
        <nav style="display:flex;gap:8px">
          {[7, 30, 90].map((d) => <a class:list={["chip", { "btn-ink": d === range }]} href={`/stats?d=${d}`} aria-current={d === range ? "true" : undefined}>{d} days</a>)}
        </nav>
      )}
    </header>

    {!authed ? (
      <section style="display:grid;gap:24px;max-width:480px">
        <p class="lede">Sign in with a one-time code sent to the studio's email.</p>
        {msg && <p class="form-error" role="alert">{msg}</p>}
        {q.get("sent") ? (
          <form method="post" action="/api/stats/verify" style="display:grid;gap:14px">
            <label class="field"><span>Code from the email</span>
              <input class="input" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required autofocus />
            </label>
            <button class="btn btn-ink" type="submit" style="justify-self:start">Sign in</button>
          </form>
        ) : null}
        <form method="post" action="/api/stats/code">
          <button class="btn" type="submit">{q.get("sent") ? "Send a new code" : "Email me a code"}</button>
        </form>
      </section>
    ) : s && (
      <>
        <section style="display:grid;gap:16px">
          <p><span style="font-size:clamp(48px,7vw,88px);font-weight:500;letter-spacing:-.04em;line-height:1">{s.total.toLocaleString("en")}</span> <span class="muted">views in the last {range} days</span></p>
          <div style="display:flex;align-items:end;gap:2px;height:160px;border-bottom:1px solid var(--line)" role="img" aria-label={`Daily views, peak ${peak}`}>
            {s.days.map((d) => <span title={`${d.day}: ${d.n}`} style={`flex:1;background:var(--ink);border-radius:2px 2px 0 0;height:${Math.max(1, (d.n / peak) * 100)}%`}></span>)}
          </div>
          <p class="muted" style="display:flex;justify-content:space-between;font-size:14px"><span>{s.days[0]?.day}</span><span>{s.days.at(-1)?.day}</span></p>
        </section>
        <div style="display:grid;gap:32px;grid-template-columns:repeat(auto-fill,minmax(min(100%,320px),1fr))">
          {[["Pages", s.pages], ["Referrers", s.refs], ["Countries", s.countries], ["Devices", s.devices]].map(([title, rows]) => (
            <section style="display:grid;gap:10px;align-content:start">
              <h2 class="h-md" style="font-size:22px">{title as string}</h2>
              <table style="width:100%;border-collapse:collapse;font-size:15px">
                <tbody>
                  {(rows as [string, number][]).map(([k, n]) => (
                    <tr style="border-top:1px solid var(--line)">
                      <td style="padding:8px 0;word-break:break-all">{k}</td>
                      <td style="padding:8px 0;text-align:right;font-variant-numeric:tabular-nums">{n}</td>
                      <td class="muted" style="padding:8px 0 8px 12px;text-align:right;width:52px">{pct(n)}%</td>
                    </tr>
                  ))}
                  {(rows as unknown[]).length === 0 && <tr><td class="muted">Nothing yet.</td></tr>}
                </tbody>
              </table>
            </section>
          ))}
        </div>
      </>
    )}
  </main>
</body>
</html>
