---
/**
 * A project or case-study image from src/assets, resized and re-encoded at
 * build time into a srcset, so a phone never downloads the 1600px desktop shot.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const files = import.meta.glob<{ default: ImageMetadata }>("../assets/**/*.{webp,jpg,png}", { eager: true });

interface Props {
  /** Path under src/assets without extension, e.g. "work/blessed" or "studies/olympus/results". */
  src: string;
  alt: string;
  sizes?: string;
  class?: string;
  eager?: boolean;
}
const { src, alt, sizes = "(min-width: 900px) 50vw, 100vw", class: cls, eager = false } = Astro.props;
const hit = Object.entries(files).find(([k]) => k.replace(/^\.\.\/assets\//, "").replace(/\.\w+$/, "") === src);
if (!hit) throw new Error(`Shot: no image at src/assets/${src}.*`);
const meta = hit[1].default;
const widths = [480, 800, 1200, 1600].filter((w) => w <= meta.width);
if (!widths.includes(meta.width) && meta.width < 1600) widths.push(meta.width);
---
<Image
  src={meta}
  alt={alt}
  widths={widths}
  sizes={sizes}
  class={cls}
  loading={eager ? "eager" : "lazy"}
  fetchpriority={eager ? "high" : undefined}
  decoding="async"
/>
