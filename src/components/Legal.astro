---
import type { TermsContent } from "../lib/terms.ts";
import type { Lang } from "../lib/i18n.ts";
interface Props { content: TermsContent; lang: Lang }
const { content: c, lang } = Astro.props;
---
<div class="wrap page-hero">
  <a class="back" href={`/${lang}`}>← {c.back}</a>
  <h1>{c.title}</h1>
  <p class="eyebrow">{c.updated}</p>
</div>
<div class="wrap">
  <div class="legal">
    {c.sections.map((s, i) => (
      <section>
        <h2><span>{String(i + 1).padStart(2, "0")}</span>{s.heading}</h2>
        {s.body.map((p) => <p>{p}</p>)}
      </section>
    ))}
    <p class="note">{c.footer}</p>
  </div>
</div>
