const { name, size = 18, class: cls } = Astro.props;
const icon = icons[name];
const attrs = Object.fromEntries([...icon.attrs.matchAll(/([\w-]+)="([^"]*)"/g)].map((m) => [m[1], m[2]]));
---
<svg width={size} height={size} {...attrs} class={cls} aria-hidden="true" focusable="false" set:html={icon.body} />
